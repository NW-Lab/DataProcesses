<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataProcesses.Desktop.ViewModels"
             xmlns:resources="using:DataProcesses.Desktop.Resources"
             x:Class="DataProcesses.Desktop.Views.FlowEditorView"
             x:CompileBindings="False"
             Focusable="True"
             FontSize="13"
             KeyDown="FlowEditorKeyDown">
    <Grid RowDefinitions="Auto,*,160" ColumnDefinitions="250,*,300">
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#172033" Padding="12,8">
            <Grid ColumnDefinitions="200,170,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Flows}"
                          SelectedItem="{Binding SelectedFlow}"
                          DisplayMemberBinding="{Binding DisplayName}" />
                <TextBox Grid.Column="1"
                         Text="{Binding FlowName}"
                         PlaceholderText="Flow name"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Add Flow" Command="{Binding AddFlowCommand}" />
                <Button Grid.Column="3" Content="Remove Flow" Command="{Binding RemoveFlowCommand}" />
                <Button Grid.Column="4" Content="New" Command="{Binding NewFlowCommand}" />
                <Button Grid.Column="5" Content="Save" Command="{Binding SaveCommand}" />
                <Button Grid.Column="6" Content="Load" Command="{Binding LoadCommand}" />
                <Button Grid.Column="7" Content="Validate" Command="{Binding ValidateCommand}" />
                <Button Grid.Column="8" Content="-" Command="{Binding ZoomOutCommand}" />
                <Button Grid.Column="9" Content="+" Command="{Binding ZoomInCommand}" />
                <TextBlock Grid.Column="11" Text="{Binding ExecutionState}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D5D9E2" BorderThickness="0,0,1,0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="Node Library" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  Content="Compact"
                                  FontSize="11"
                                  Padding="6,2"
                                  IsChecked="{Binding Palette.IsCompact}"
                                  ToolTip.Tip="Show Blocks as single-line rows"
                                  AutomationProperties.Name="Compact Node Library view" />
                    <Button Grid.Column="2"
                            Content="+"
                            FontSize="11"
                            Padding="6,2"
                            Command="{Binding Palette.ExpandAllCommand}"
                            ToolTip.Tip="Expand all groups"
                            AutomationProperties.Name="Expand all Node Library groups" />
                    <Button Grid.Column="3"
                            Content="-"
                            FontSize="11"
                            Padding="6,2"
                            Command="{Binding Palette.CollapseAllCommand}"
                            ToolTip.Tip="Collapse all groups"
                            AutomationProperties.Name="Collapse all Node Library groups" />
                </Grid>
                <TextBox Grid.Row="1" PlaceholderText="Search nodes" Text="{Binding Palette.SearchText}" AutomationProperties.Name="Search nodes" />
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Input" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                        <ComboBox ItemsSource="{Binding Palette.DataTypeOptions}"
                                  SelectedItem="{Binding Palette.SelectedInputDataType}"
                                  MinWidth="96" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Output" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                        <ComboBox ItemsSource="{Binding Palette.DataTypeOptions}"
                                  SelectedItem="{Binding Palette.SelectedOutputDataType}"
                                  MinWidth="96" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- Inputs enter the Block glyph from the left; outputs leave it to the right.
                             Column widths are shared within a group so the glyph lines up between its rows. -->
                        <DataTemplate x:Key="PalettePortFlowTemplate" DataType="vm:PaletteNodeViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PaletteInputs" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PaletteOutputs" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                                            IsVisible="{Binding HasInputBadges}">
                                    <ItemsControl ItemsSource="{Binding InputBadges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="&#x2192;" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="8"
                                        Height="14"
                                        Margin="1,0"
                                        CornerRadius="2"
                                        Background="#475569"
                                        VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left"
                                            IsVisible="{Binding HasOutputBadges}">
                                    <TextBlock Text="&#x2192;" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding OutputBadges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Palette.Groups}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:PalettePortBadgeViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="2" ToolTip.Tip="{Binding Description}">
                                    <!-- Fast Stream: circle with S; JSON Message: diamond with J. Shape and letter, not color alone. -->
                                    <Panel Width="13" Height="13" IsVisible="{Binding IsFastStream}" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding KindColor}" />
                                        <TextBlock Text="S" Foreground="White" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                    <Panel Width="13" Height="13" IsVisible="{Binding IsJsonMessage}" VerticalAlignment="Center">
                                        <Path Data="M 6.5,0 L 13,6.5 L 6.5,13 L 0,6.5 Z" Fill="{Binding KindColor}" />
                                        <TextBlock Text="J" Foreground="White" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                    <TextBlock Text="{Binding SchemaLabel}"
                                               IsVisible="{Binding HasSchemaLabel}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PaletteNodeGroupViewModel">
                                <Expander Margin="0,0,0,6"
                                          Padding="0,4,0,0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding DisplayName}">
                                    <Expander.Resources>
                                        <x:Double x:Key="ExpanderMinHeight">30</x:Double>
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#E2E8F0" CornerRadius="8" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#334155" />
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Categories}" Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:PaletteNodeCategoryViewModel">
                                                <StackPanel Margin="0,0,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               IsVisible="{Binding $parent[Expander].DataContext.ShowCategoryHeaders}"
                                                               Margin="2,4,0,2"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.75" />
                                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:PaletteNodeViewModel">
                                                                <Panel ToolTip.Tip="{Binding ToolTipText}"
                                                                       AutomationProperties.Name="{Binding AccessibleName}"
                                                                       Cursor="Hand">
                                                                    <!-- Compact single-line row. -->
                                                                    <Border IsVisible="{Binding $parent[UserControl].DataContext.Palette.IsCompact}"
                                                                            Margin="0,0,0,2"
                                                                            Padding="6,3"
                                                                            Background="#FFFFFF"
                                                                            BorderBrush="#CBD5E1"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4">
                                                                        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="6">
                                                                            <Image IsVisible="{Binding HasIcon}" Source="{Binding IconImage}"
                                                                                   Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Title}"
                                                                                       Foreground="#0F172A"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="12"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" />
                                                                            <ContentControl Grid.Column="2"
                                                                                            Content="{Binding}"
                                                                                            ContentTemplate="{StaticResource PalettePortFlowTemplate}"
                                                                                            VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <!-- Detailed card. -->
                                                                    <Border IsVisible="{Binding !$parent[UserControl].DataContext.Palette.IsCompact}"
                                                                            Margin="0,0,0,4"
                                                                            Padding="8,6"
                                                                            Background="#FFFFFF"
                                                                            BorderBrush="#94A3B8"
                                                                            BorderThickness="1"
                                                                            CornerRadius="5">
                                                                        <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                                                            <Border Grid.RowSpan="3"
                                                                                    Width="24"
                                                                                    Height="24"
                                                                                    Background="#E2E8F0"
                                                                                    CornerRadius="6"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center">
                                                                                <Image IsVisible="{Binding HasIcon}" Source="{Binding IconImage}" Stretch="Uniform" Margin="3" />
                                                                            </Border>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="9" Foreground="#475569" TextWrapping="Wrap" />
                                                                            <ContentControl Grid.Row="2" Grid.Column="1"
                                                                                            Margin="0,3,0,0"
                                                                                            HorizontalAlignment="Left"
                                                                                            Content="{Binding}"
                                                                                            ContentTemplate="{StaticResource PalettePortFlowTemplate}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#EEF2F7" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="CanvasRoot"
                    Width="2400"
                    Height="1600"
                        Background="#F7F9FC">
                    <ItemsControl Width="2400" Height="1600" ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CanvasConnectionViewModel">
                                <Grid PointerPressed="ConnectionPointerPressed">
                                    <!-- Wide transparent hit area to make right-click easier. -->
                                    <Path Data="{Binding PathData}"
                                          Stroke="Transparent"
                                          StrokeThickness="14"
                                          ZIndex="18" />

                                    <Path Data="{Binding PathData}"
                                          Stroke="{Binding StrokeColor}"
                                          StrokeThickness="3.5"
                                          StrokeDashArray="{Binding StrokeDashArray}"
                                          ZIndex="20"
                                        ToolTip.Tip="{Binding ConnectionLabel}" />

                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding}">
                                            <MenuItem Header="Set Tag..."
                                                      Click="SetConnectionTagMenuItemClicked" />
                                            <MenuItem Header="Clear Tag"
                                                      Click="ClearConnectionTagMenuItemClicked" />
                                            <MenuItem Header="Delete"
                                                      Click="DeleteConnectionMenuItemClicked" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Preview connection line while connecting -->
                    <Path IsVisible="{Binding ShowPreviewConnection}"
                          Data="{Binding PreviewConnectionPath}"
                          Stroke="#FFB000"
                          StrokeThickness="3.5"
                          StrokeDashArray="6,3"
                          ZIndex="120">
                        <Path.Styles>
                            <Style Selector="Path">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="0.85" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Path.Styles>
                    </Path>

                    <ItemsControl x:Name="NodesItemsControl" Width="2400" Height="1600" ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl#NodesItemsControl > ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CanvasNodeViewModel">
                                <Border Width="180"
                                    MinHeight="96"
                                        Background="White"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        PointerPressed="NodePointerPressed"
                                        PointerMoved="NodePointerMoved"
                                        PointerReleased="NodePointerReleased">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding}">
                                            <MenuItem Header="Delete"
                                                      Click="DeleteNodeMenuItemClicked" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*">
                                        <Border Grid.ColumnSpan="2" Background="#1E293B" CornerRadius="6,6,0,0" Padding="8,6">
                                            <Grid>
                                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
                                                    <Border Width="22"
                                                            Height="22"
                                                            Background="#334155"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center">
                                                        <Image IsVisible="{Binding HasIcon}" Source="{Binding IconImage}" Stretch="Uniform" Margin="2" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            Padding="8,2"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Background="#DDEB36"
                                                            Foreground="#1E293B"
                                                            BorderBrush="#DDEB36"
                                                            PointerPressed="NodeTriggerButtonPointerPressed"
                                                            Click="NodeTriggerButtonClicked"
                                                            IsVisible="{Binding IsTriggerNode}">
                                                        <TextBlock Text="Trigger" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <ItemsControl Grid.Row="1" Grid.Column="0" Margin="8" ItemsSource="{Binding Inputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CanvasPortViewModel">
                                                    <Button Margin="0,0,0,4"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Left"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding ToolTipText}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                                            <Border IsVisible="{Binding HasDetailedSchema}"
                                                                    Background="{Binding SchemaBadgeBackground}"
                                                                    BorderBrush="{Binding SchemaBadgeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SchemaBadge}"
                                                                           Foreground="{Binding SchemaBadgeForeground}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <Grid Width="74" ColumnDefinitions="*" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding DisplayName}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl Grid.Row="1" Grid.Column="1" Margin="8" ItemsSource="{Binding Outputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CanvasPortViewModel">
                                                    <Button Margin="0,0,0,4"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding ToolTipText}">
                                                        <Grid Width="74" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Right">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10"
                                                                       TextAlignment="Right"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border IsVisible="{Binding HasDetailedSchema}"
                                                                    Grid.Column="1"
                                                                    Background="{Binding SchemaBadgeBackground}"
                                                                    BorderBrush="{Binding SchemaBadgeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SchemaBadge}"
                                                                           Foreground="{Binding SchemaBadgeForeground}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="PaletteDragPreview"
                            Width="180"
                            MinHeight="54"
                            Padding="8,6"
                            Background="#E0F2FE"
                            BorderBrush="#1D70B8"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Opacity="0.9">
                        <Grid ColumnDefinitions="32,*" RowDefinitions="Auto,Auto">
                            <Border Grid.RowSpan="2"
                                    Width="20"
                                    Height="20"
                                    Background="#1D70B8"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="PaletteDragPreviewTitle"
                                       Grid.Column="1"
                                       Foreground="#0F172A"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Release to place"
                                       Foreground="#475569"
                                       FontSize="10" />
                        </Grid>
                    </Border>
                </Canvas>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#D5D9E2" BorderThickness="1,0,0,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,180,Auto,Auto" RowSpacing="6" Margin="0,0,14,0">
                    <TextBlock Text="Inspector" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding SelectedNode.TypeId}" Foreground="#526071" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Grid.Row="2" Text="Name" FontWeight="SemiBold" />
                    <TextBox Grid.Row="3" Text="{Binding SelectedNode.Name}" />
                    <TextBlock Grid.Row="4" Text="Description" FontWeight="SemiBold" />
                    <TextBox Grid.Row="5" Text="{Binding SelectedNode.Description}" />
                    <CheckBox Grid.Row="6" Content="Enabled" IsChecked="{Binding SelectedNode.IsEnabled}" />
                    <StackPanel Grid.Row="7" Spacing="4">
                        <CheckBox Content="Show on Dashboard" IsChecked="{Binding SelectedNode.ShowOnDashboard}" />
                        <CheckBox Content="Wrap dashboard text"
                                  IsChecked="{Binding SelectedNode.DashboardTextWrapEnabled}"
                                  IsVisible="{Binding SelectedNode.ShowOnDashboard}" />
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="TestSignal settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalOrVector}" />
                    <TextBlock Grid.Row="8" Text="Signal input settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsSignalInspectorNode}" />
                    <StackPanel Grid.Row="9" Spacing="5" IsVisible="{Binding SelectedNode.IsSignalInspectorNode}">
                        <TextBlock Text="Wave type" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalInspectorNode}" />
                        <ComboBox ItemsSource="{Binding SelectedNode.TestSignalWaveTypes}"
                                  SelectedItem="{Binding SelectedNode.TestSignalWaveType}"
                                  IsVisible="{Binding SelectedNode.IsTestSignalInspectorNode}" />
                        <TextBlock Text="Frequency (Hz)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalOrVector}" />
                        <NumericUpDown Minimum="0.001"
                                       Increment="1"
                                       Value="{Binding SelectedNode.TestSignalFrequencyHertz}"
                                       IsVisible="{Binding SelectedNode.IsTestSignalOrVector}" />
                        <TextBlock Text="Frequency (Hz)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <NumericUpDown Minimum="0.001"
                                       Increment="1"
                                       Maximum="{Binding SelectedNode.TestSignalFSNyquistFrequencyHertz}"
                                       Value="{Binding SelectedNode.TestSignalFSFrequencyHertz}"
                                       IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <TextBlock Text="Peak intensity" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <NumericUpDown Minimum="0"
                                       Increment="0.1"
                                       Value="{Binding SelectedNode.TestSignalFSPeakIntensity}"
                                       IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <TextBlock Text="Sampling frequency (Hz)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <NumericUpDown Minimum="1"
                                       Maximum="1000000"
                                       Increment="1000"
                                       Value="{Binding SelectedNode.TestSignalFSSampleRateHertz}"
                                       IsVisible="{Binding SelectedNode.IsTestSignalFSNode}" />
                        <TextBlock Text="Input sample rate (Hz)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMicInputFSNode}" />
                        <NumericUpDown Minimum="8000"
                                       Maximum="192000"
                                       Increment="1000"
                                       Value="{Binding SelectedNode.MicInputFSSampleRateHertz}"
                                       IsVisible="{Binding SelectedNode.IsMicInputFSNode}" />
                        <TextBlock Text="Channel mode" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMicInputFSNode}" />
                        <ComboBox ItemsSource="{Binding SelectedNode.MicInputFSChannelModes}"
                                  SelectedItem="{Binding SelectedNode.MicInputFSChannelMode}"
                                  IsVisible="{Binding SelectedNode.IsMicInputFSNode}"
                                  AutomationProperties.Name="Microphone channel mode" />
                        <TextBlock Text="Input device: system default" IsVisible="{Binding SelectedNode.IsMicInputFSNode}" />
                        <TextBlock Text="Sampling time (ms)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignal}" />
                        <NumericUpDown Minimum="0.001"
                                       Increment="0.1"
                                       Value="{Binding SelectedNode.TestSignalSamplePeriodMilliseconds}"
                                       IsVisible="{Binding SelectedNode.IsTestSignal}" />
                        <TextBlock Text="Vector length" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalVec}" />
                        <NumericUpDown Minimum="1"
                                       Maximum="1024"
                                       Increment="1"
                                       Value="{Binding SelectedNode.TestSignalVectorLength}"
                                       IsVisible="{Binding SelectedNode.IsTestSignalVec}" />
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="Audio output settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsAudioOutFSNode}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsAudioOutFSNode}">
                        <TextBlock Text="Recording folder" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.AudioOutFSRecordingFolder}"
                                 PlaceholderText="C:/Users/you/Music/DataProcesses" />
                        <TextBlock Text="Recording file name prefix" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.AudioOutFSFileNamePrefix}"
                                 PlaceholderText="audio" />
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="Trigger settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTriggerNode}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsTriggerNode}">
                        <CheckBox Content="Emit on execution start" IsChecked="{Binding SelectedNode.TriggerEmitOnExecutionStart}" />
                        <CheckBox Content="Emit periodically" IsChecked="{Binding SelectedNode.TriggerEmitPeriodically}" />
                        <TextBlock Text="Initial delay (ms)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="0"
                                       Increment="100"
                                       Value="{Binding SelectedNode.TriggerInitialDelayMilliseconds}" />
                        <TextBlock Text="Repeat interval (ms)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Increment="100"
                                       Value="{Binding SelectedNode.TriggerRepeatIntervalMilliseconds}" />
                        <TextBlock Text="Topic" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.TriggerTopic}" />
                        <TextBlock Text="Payload path" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.TriggerPayloadPath}" />
                        <TextBlock Text="Payload value type" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.TriggerPayloadValueTypes}"
                                  SelectedItem="{Binding SelectedNode.TriggerPayloadValueType}" />
                        <StackPanel Spacing="4"
                                IsVisible="{Binding SelectedNode.IsTriggerBoolEditorVisible}">
                            <TextBlock Text="Boolean value" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SelectedNode.TriggerBooleanChoices}"
                                  SelectedItem="{Binding SelectedNode.TriggerBoolValue}" />
                        </StackPanel>
                        <TextBox Text="{Binding SelectedNode.TriggerStringValue}"
                                 PlaceholderText="String value"
                                 IsVisible="{Binding SelectedNode.IsTriggerStringEditorVisible}" />
                        <NumericUpDown Value="{Binding SelectedNode.TriggerNumberValue}"
                                       Increment="1"
                                       IsVisible="{Binding SelectedNode.IsTriggerNumberEditorVisible}" />
                        <TextBox Text="{Binding SelectedNode.TriggerNumberArrayText}"
                                 PlaceholderText="1,2,3"
                                 IsVisible="{Binding SelectedNode.IsTriggerNumberArrayEditorVisible}" />
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="Moving Average settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMovingAverageNode}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsMovingAverageNode}">
                        <TextBlock Text="Window mode" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.MovingAverageWindowModes}"
                                  SelectedItem="{Binding SelectedNode.MovingAverageWindowMode}" />
                        <TextBlock Text="Sample count" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMovingAverageSampleWindowVisible}" />
                        <NumericUpDown Minimum="1"
                                       Increment="1"
                                       Value="{Binding SelectedNode.MovingAverageWindowSize}"
                                       IsVisible="{Binding SelectedNode.IsMovingAverageSampleWindowVisible}" />
                        <TextBlock Text="Window duration (ms)" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMovingAverageDurationWindowVisible}" />
                        <NumericUpDown Minimum="0.001"
                                       Increment="10"
                                       Maximum="{Binding SelectedNode.TestSignalFSNyquistFrequencyHertz}"
                                       Value="{Binding SelectedNode.MovingAverageWindowDurationMilliseconds}"
                                       IsVisible="{Binding SelectedNode.IsMovingAverageDurationWindowVisible}" />
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="TestSignal image settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsTestSignalImg}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsTestSignalImg}">
                        <TextBlock Text="Type" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.TestSignalImageTypes}"
                                  SelectedItem="{Binding SelectedNode.TestSignalImageType}" />
                        <TextBlock Text="Mode" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.TestSignalImageModes}"
                                  SelectedItem="{Binding SelectedNode.TestSignalImageMode}" />
                        <TextBlock Text="Frequency (Hz)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="0.001"
                                       Increment="0.5"
                                       Value="{Binding SelectedNode.TestSignalImageFrequencyHertz}" />
                        <TextBlock Text="Width" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="1024"
                                       Increment="1"
                                       Value="{Binding SelectedNode.TestSignalImageWidth}" />
                        <TextBlock Text="Height" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="1024"
                                       Increment="1"
                                       Value="{Binding SelectedNode.TestSignalImageHeight}" />
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="Camera input settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsCameraSourceNode}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsCameraSourceNode}">
                        <TextBlock Text="Camera device index" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="0"
                                       Increment="1"
                                       Value="{Binding SelectedNode.CameraInputImageDeviceIndex}" />
                        <TextBlock Text="Requested width" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="3840"
                                       Increment="1"
                                       Value="{Binding SelectedNode.CameraInputImageWidth}" />
                        <TextBlock Text="Requested height" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="2160"
                                       Increment="1"
                                       Value="{Binding SelectedNode.CameraInputImageHeight}" />
                        <CheckBox Content="Continuous capture"
                                  IsChecked="{Binding SelectedNode.CameraInputImageContinuousCapture}"
                                  IsVisible="{Binding SelectedNode.IsCameraInputImageNode}" />
                        <TextBlock Text="FPS" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="0.1"
                                       Maximum="60"
                                       Increment="1"
                                       Value="{Binding SelectedNode.CameraInputImageFramesPerSecond}" />
                        <CheckBox Content="Auto white balance" IsChecked="{Binding SelectedNode.CameraWhiteBalanceAuto}" />
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.IsCameraWhiteBalanceTemperatureVisible}">
                            <TextBlock Text="White balance temperature (K)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="2000"
                                           Maximum="10000"
                                           Increment="100"
                                           Value="{Binding SelectedNode.CameraWhiteBalanceTemperature}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="10" Text="Movie Input Image settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMovieInputImageNode}" />
                    <StackPanel Grid.Row="11" Spacing="5" IsVisible="{Binding SelectedNode.IsMovieInputImageNode}">
                        <TextBlock Text="Movie file path" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MovieInputImagePath}"
                                 PlaceholderText="C:/data/input.mp4" />
                        <TextBlock Text="FPS" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="0.1"
                                       Maximum="60"
                                       Increment="1"
                                       Value="{Binding SelectedNode.MovieInputImageFramesPerSecond}" />
                        <TextBlock Text="Output width" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="3840"
                                       Increment="1"
                                       Value="{Binding SelectedNode.MovieInputImageWidth}" />
                        <TextBlock Text="Output height" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="3840"
                                       Increment="1"
                                       Value="{Binding SelectedNode.MovieInputImageHeight}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="CSV Input settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsCsvInputNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsCsvInputNode}">
                        <TextBlock Text="Output stream count" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="16"
                                       Increment="1"
                                       Value="{Binding SelectedNode.CsvInputOutputCount}" />
                        <CheckBox Content="CSV has header row" IsChecked="{Binding SelectedNode.CsvInputHasHeaderRow}" />
                        <TextBlock Text="Input source" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.CsvInputSourceTypes}"
                                  SelectedItem="{Binding SelectedNode.CsvInputSourceType}" />
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.CsvInputIsFileSourceVisible}">
                            <TextBlock Text="CSV file path" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedNode.CsvInputFilePath}"
                                     PlaceholderText="C:/data/input.csv" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.CsvInputIsFilePlaybackVisible}">
                            <TextBlock Text="File playback mode" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SelectedNode.CsvInputFilePlaybackModes}"
                                      SelectedItem="{Binding SelectedNode.CsvInputFilePlaybackMode}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.CsvInputIsComSourceVisible}">
                            <TextBlock Text="COM port" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedNode.CsvInputComPortName}" PlaceholderText="COM3" />
                            <TextBlock Text="Baud rate" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="1"
                                           Increment="9600"
                                           Value="{Binding SelectedNode.CsvInputBaudRate}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="Serial Input TS settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsSerialInputTSNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsSerialInputTSNode}">
                        <TextBlock Text="COM port" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.SerialInputTSComPorts}"
                                  SelectedItem="{Binding SelectedNode.SerialInputTSComPortName}" />
                        <TextBlock Text="Baud rate" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Increment="9600"
                                       Value="{Binding SelectedNode.SerialInputTSBaudRate}" />
                        <TextBlock Text="Channel count" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="16"
                                       Increment="1"
                                       Value="{Binding SelectedNode.SerialInputTSChannelCount}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="Serial Input Vector settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsSerialInputVectorNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsSerialInputVectorNode}">
                        <TextBlock Text="COM port" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.SerialInputTSComPorts}"
                                  SelectedItem="{Binding SelectedNode.SerialInputVectorComPortName}" />
                        <TextBlock Text="Baud rate" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Increment="9600"
                                       Value="{Binding SelectedNode.SerialInputVectorBaudRate}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="BLE Input settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsBleInputNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsBleInputNode}">
                        <TextBlock Text="BLE device" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SelectedNode.BleInputTSDeviceChoices}"
                                      SelectedItem="{Binding SelectedNode.BleInputTSSelectedDevice}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="Scan"
                                    Command="{Binding SelectedNode.BleInputTSRefreshDevicesCommand}" />
                        </Grid>
                        <TextBlock Text="Device id" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.BleInputTSDeviceId}"
                                 PlaceholderText="Persisted BLE device id" />
                        <TextBlock Text="Device name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.BleInputTSDeviceName}"
                                 PlaceholderText="Arduino BLE" />
                        <CheckBox Content="Auto connect next run" IsChecked="{Binding SelectedNode.BleInputTSAutoConnect}" />
                        <TextBlock Text="Service UUID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.BleInputTSServiceUuid}" />
                        <TextBlock Text="Notify characteristic UUID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.BleInputTSNotifyCharacteristicUuid}" />
                        <Button Content="Reset Nordic UUIDs"
                                Command="{Binding SelectedNode.BleInputTSResetNordicUuidsCommand}" />
                        <TextBlock Text="Channel count" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsBleChannelCountVisible}" />
                        <NumericUpDown Minimum="1"
                                       Maximum="16"
                                       Increment="1"
                                   Value="{Binding SelectedNode.BleInputTSChannelCount}"
                                   IsVisible="{Binding SelectedNode.IsBleChannelCountVisible}" />
                        <StackPanel Spacing="5" IsVisible="{Binding SelectedNode.IsBleInputFSNode}">
                            <TextBlock Text="{x:Static resources:BleInputFSStrings.Format}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SelectedNode.BleInputFSFormats}"
                                      SelectedItem="{Binding SelectedNode.BleInputFSFormat}"
                                      AutomationProperties.Name="{x:Static resources:BleInputFSStrings.Format}" />
                            <TextBlock Text="{x:Static resources:BleInputFSStrings.SampleRate}" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="1" Maximum="1000000" Increment="1"
                                           Value="{Binding SelectedNode.BleInputFSSampleRateHertz}"
                                           AutomationProperties.Name="{x:Static resources:BleInputFSStrings.SampleRate}" />
                            <StackPanel Spacing="5" IsVisible="{Binding SelectedNode.IsBleInputFSBinary}">
                                <TextBlock Text="{x:Static resources:BleInputFSStrings.NumericType}" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding SelectedNode.BleInputFSNumericTypes}"
                                          SelectedItem="{Binding SelectedNode.BleInputFSNumericType}"
                                          AutomationProperties.Name="{x:Static resources:BleInputFSStrings.NumericType}" />
                                <TextBlock Text="{x:Static resources:BleInputFSStrings.ByteOrder}" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding SelectedNode.BleInputFSByteOrders}"
                                          SelectedItem="{Binding SelectedNode.BleInputFSByteOrder}"
                                          AutomationProperties.Name="{x:Static resources:BleInputFSStrings.ByteOrder}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Timeout (ms)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Maximum="600000"
                                       Increment="500"
                                       Value="{Binding SelectedNode.BleInputTSTimeoutMilliseconds}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="CSV Output settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsCsvOutputNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsCsvOutputNode}">
                        <TextBlock Text="CSV file path" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedNode.CsvOutputFilePath}"
                                     PlaceholderText="C:/data/output.csv" />
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Click="BrowseCsvOutputFilePathClicked" />
                        </Grid>
                        <TextBlock Text="Write mode" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.CsvOutputWriteModes}"
                                  SelectedItem="{Binding SelectedNode.CsvOutputWriteMode}" />
                        <TextBlock Text="Span time (ms)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1"
                                       Increment="10"
                                       Value="{Binding SelectedNode.CsvOutputSpanMilliseconds}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="StreamChartVector settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsStreamChartVectorNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsStreamChartVectorNode}">
                        <TextBlock Text="Color map" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.StreamChartVectorColorMaps}"
                                  SelectedItem="{Binding SelectedNode.StreamChartVectorColorMap}" />
                        <CheckBox Content="Auto scale" IsChecked="{Binding SelectedNode.StreamChartVectorAutoScale}" />
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.StreamChartVectorIsManualScaleVisible}">
                            <TextBlock Text="Min value" FontWeight="SemiBold" />
                            <NumericUpDown Increment="0.1"
                                           Value="{Binding SelectedNode.StreamChartVectorMinimumValue}" />
                            <TextBlock Text="Max value" FontWeight="SemiBold" />
                            <NumericUpDown Increment="0.1"
                                           Value="{Binding SelectedNode.StreamChartVectorMaximumValue}" />
                        </StackPanel>
                        <CheckBox Content="Interpolate between samples" IsChecked="{Binding SelectedNode.StreamChartVectorInterpolate}" />
                        <TextBlock Text="Time axis span (ms)" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="100"
                                       Maximum="600000"
                                       Increment="500"
                                       Value="{Binding SelectedNode.StreamChartVectorTimeSpanMilliseconds}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="BreathTS settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsBreathTSNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsBreathTSNode}">
                        <TextBlock Text="Detection method" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.BreathTSDetectionMethods}"
                                  SelectedItem="{Binding SelectedNode.BreathTSDetectionMethod}" />
                        <CheckBox Content="Emit anomaly events"
                                  IsChecked="{Binding SelectedNode.BreathTSEmitAnomalyEvents}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="FilterTS settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsFilterTSNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsFilterTSNode}">
                        <TextBlock Text="Filter type" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.FilterTSTypes}"
                                  SelectedItem="{Binding SelectedNode.FilterTSType}" />
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.FilterTSIsSingleCutoffVisible}">
                            <TextBlock Text="Cutoff frequency (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterTSCutoffFrequencyHertz}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.FilterTSIsBandCutoffVisible}">
                            <TextBlock Text="Lower cutoff (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterTSLowerCutoffFrequencyHertz}" />
                            <TextBlock Text="Upper cutoff (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterTSUpperCutoffFrequencyHertz}" />
                        </StackPanel>
                        <TextBlock Text="Order" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.FilterTSOrders}"
                                  SelectedItem="{Binding SelectedNode.FilterTSOrder}" />
                        <Border Height="92"
                                Padding="8"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid RowDefinitions="*,Auto">
                                <Canvas Width="248" Height="72" HorizontalAlignment="Stretch">
                                    <Line StartPoint="0,72" EndPoint="248,72" Stroke="#CBD5E1" StrokeThickness="1" />
                                    <Line StartPoint="0,36" EndPoint="248,36" Stroke="#E2E8F0" StrokeThickness="1" />
                                    <Line StartPoint="0,0" EndPoint="0,72" Stroke="#CBD5E1" StrokeThickness="1" />
                                    <Polyline Points="{Binding SelectedNode.FilterTSResponsePoints}"
                                              Stroke="#1D70B8"
                                              StrokeThickness="2" />
                                </Canvas>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedNode.FilterTSResponseCaption}"
                                           Foreground="#526071"
                                           FontSize="10"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="FilterFS settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsFilterFSNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsFilterFSNode}">
                        <TextBlock Text="Filter type" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.FilterFSTypes}"
                                  SelectedItem="{Binding SelectedNode.FilterFSFilterType}" />
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.FilterFSIsSingleCutoffVisible}">
                            <TextBlock Text="Cutoff frequency (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterFSCutoffFrequencyHertz}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.FilterFSIsBandCutoffVisible}">
                            <TextBlock Text="Lower cutoff (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterFSLowerCutoffFrequencyHertz}" />
                            <TextBlock Text="Upper cutoff (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterFSUpperCutoffFrequencyHertz}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedNode.FilterFSIsNotchVisible}">
                            <TextBlock Text="Center frequency (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterFSCutoffFrequencyHertz}" />
                            <TextBlock Text="Notch bandwidth (Hz)" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="0.001"
                                           Increment="0.5"
                                           Value="{Binding SelectedNode.FilterFSNotchBandwidthHertz}" />
                        </StackPanel>
                        <TextBlock Text="Order" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.FilterFSOrders}"
                                  SelectedItem="{Binding SelectedNode.FilterFSOrder}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="MQTT_In settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMqttInNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsMqttInNode}">
                        <TextBlock Text="Broker host" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttInBrokerHost}" />
                        <TextBlock Text="Port" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding SelectedNode.MqttInPort}" />
                        <TextBlock Text="Client ID (blank = automatic)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttInClientId}" />
                        <TextBlock Text="Username" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttInUsername}" />
                        <TextBlock Text="Password (stored in project settings)" FontWeight="SemiBold" />
                        <TextBox PasswordChar="*" Text="{Binding SelectedNode.MqttInPassword}" />
                        <CheckBox Content="Use TLS" IsChecked="{Binding SelectedNode.MqttInUseTls}" />
                        <TextBlock Text="Topic filter" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttInTopic}" />
                        <TextBlock Text="Quality of service" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.MqttQualityOfServiceLevels}"
                                  SelectedItem="{Binding SelectedNode.MqttInQualityOfService}" />
                    </StackPanel>
                    <TextBlock Grid.Row="12" Text="MQTT_Out settings" FontWeight="SemiBold" IsVisible="{Binding SelectedNode.IsMqttOutNode}" />
                    <StackPanel Grid.Row="13" Spacing="5" IsVisible="{Binding SelectedNode.IsMqttOutNode}">
                        <TextBlock Text="Broker host" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttOutBrokerHost}" />
                        <TextBlock Text="Port" FontWeight="SemiBold" />
                        <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding SelectedNode.MqttOutPort}" />
                        <TextBlock Text="Client ID (blank = automatic)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttOutClientId}" />
                        <TextBlock Text="Username" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttOutUsername}" />
                        <TextBlock Text="Password (stored in project settings)" FontWeight="SemiBold" />
                        <TextBox PasswordChar="*" Text="{Binding SelectedNode.MqttOutPassword}" />
                        <CheckBox Content="Use TLS" IsChecked="{Binding SelectedNode.MqttOutUseTls}" />
                        <TextBlock Text="Topic (blank = message topic)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedNode.MqttOutTopic}" />
                        <TextBlock Text="Quality of service" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding SelectedNode.MqttQualityOfServiceLevels}"
                                  SelectedItem="{Binding SelectedNode.MqttOutQualityOfService}" />
                        <CheckBox Content="Retain message" IsChecked="{Binding SelectedNode.MqttOutRetain}" />
                    </StackPanel>
                    <TextBox Grid.Row="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Text="{Binding SelectedNode.SettingsJson}"
                             PlaceholderText="Block-specific settings JSON" />
                    <TextBlock Grid.Row="15" Text="Project directory" FontWeight="SemiBold" />
                    <TextBox Grid.Row="16" Text="{Binding ProjectDirectory}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <TabControl FontSize="12" Background="#FFFFFF">
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Validation Issues" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" />
                        </TabItem.Header>
                        <ListBox ItemsSource="{Binding ValidationIssues}" BorderThickness="0" Background="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ValidationIssueViewModel">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#1E293B" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Execution Log" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" />
                        </TabItem.Header>
                        <ListBox ItemsSource="{Binding ExecutionLogs}" BorderThickness="0" Background="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ExecutionLogEntryViewModel">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1E293B">
                                        <Run Text="{Binding Timestamp}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Level}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding NodeId}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Message}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Margin="0,3,8,0"
                            Spacing="6">
                    <Button Padding="10,3"
                            FontSize="12"
                            Background="#E2E8F0"
                            BorderBrush="#94A3B8"
                            Click="CopyExecutionLogClicked"
                            ToolTip.Tip="Copy execution log">
                        <TextBlock Text="Copy Log" Foreground="#0F172A" FontSize="12" />
                    </Button>
                    <Button Padding="10,3"
                            FontSize="12"
                            Background="#E2E8F0"
                            BorderBrush="#94A3B8"
                            Command="{Binding ClearExecutionLogsCommand}"
                            ToolTip.Tip="Clear execution log">
                        <TextBlock Text="Clear Log" Foreground="#0F172A" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
